r-radius: var(--radius-lg);padding: 26px;box-shadow: var(--shadow-sm);position: relative}\n.flow .step .num {font-size: 28px;font-weight: 700;color: var(--teal-100);margin-bottom: 10px}\n.flow .step h4 {font-size: 15px;font-weight: 600;color: var(--slate-900);margin-bottom: 6px}\n.flow .step p {font-size: 13px;color: var(--slate-700)}\n\n.clients {display: grid;grid-template-columns: repeat(3, minmax(0, 1fr));gap: 24px}\n.client-card {background: var(--card);border-radius: var(--radius-lg);padding: 28px;box-shadow: var(--shadow-sm)}\n.client-card .os {font-size: 12px;letter-spacing: 1.5px;text-transform: uppercase;color: var(--teal-600)}\n.client-card h4 {font-size: 17px;color: var(--slate-900);margin: 8px 0 12px}\n.client-card p {font-size: 13px;color: var(--slate-700);margin-bottom: 16px}\n.client-card ul {list-style: none}\n.client-card ul li {font-size: 12px;color: var(--slate-500);padding: 6px 0;border-top: 1px dashed var(--slate-100)}\n.client-card ul li:first-child {border-top: 0}\n.client-card .dl {display: inline-block;margin-top: 14px;font-size: 12px;color: var(--teal-600);font-weight: 500}\n\n.faq-list {display: flex;flex-direction: column;gap: 14px}\n.faq-item {background: var(--card);border-radius: var(--radius-md);padding: 22px 26px;box-shadow: var(--shadow-sm);display: grid;grid-template-columns: 48px 1fr;gap: 18px;align-items: start}\n.faq-item .num {font-size: 14px;font-weight: 700;color: var(--teal-600);background: var(--teal-50);border-radius: 8px;padding: 6px 10px;text-align: center;align-self: start}\n.faq-item h3 {font-size: 16px;color: var(--slate-900);margin-bottom: 8px;font-weight: 600}\n.faq-item p {font-size: 14px;color: var(--slate-700)}\n\n.contact-card {background: var(--card);border-radius: var(--radius-lg);padding: 36px;box-shadow: var(--shadow-md);display: grid;grid-template-columns: 1fr 1fr;gap: 32px;margin-top: 32px}\n.contact-card h3 {font-size: 20px;color: var(--slate-900);margin-bottom: 12px}\n.contact-card p {font-size: 14px;color: var(--slate-700)}\n.contact-card .ch {font-size: 12px;color: var(--slate-500);letter-spacing: 1px;text-transform: uppercase;margin-bottom: 6px}\n.contact-card .row {padding: 12px 0;border-bottom: 1px dashed var(--slate-100)}\n.contact-card .row:last-child {border-bottom: 0}\n.contact-card .row .v {font-size: 14px;color: var(--slate-900);font-weight: 500}\n\nfooter.site-footer {padding: 40px 0 56px;color: var(--slate-500);font-size: 13px}\nfooter .container {display: flex;justify-content: space-between;align-items: center;border-top: 1px solid var(--slate-100);padding-top: 24px;gap: 18px;flex-wrap: wrap}\nfooter .links {display: flex;gap: 22px;flex-wrap: wrap}\n\n@media (max-width: 960px) {\n  .hero-grid {grid-template-columns: 1fr;gap: 32px}\n  .hero h1 {font-size: 40px}\n  .cards-3, .usage-grid, .clients, .flow {grid-template-columns: 1fr 1fr}\n  .plan-row {grid-template-columns: 1fr 1fr}\n  .plan-row .plan-features {grid-column: 1 / -1}\n  .plan-row .plan-cta {grid-column: 1 / -1;justify-self: start}\n  .contact-card {grid-template-columns: 1fr}\n}\n@media (max-width: 600px) {\n  .hero h1 {font-size: 32px}\n  .cards-3, .usage-grid, .clients, .flow {grid-template-columns: 1fr}\n  .plan-row {grid-template-columns: 1fr;padding: 24px}\n  section {padding: 40px 0}\n  .container {padding: 0 20px}\n  .usage {padding: 28px}\n}\n</style><header class=\"site-header\">\n  <div class=\"container\">\n    <a href=\"#\" class=\"brand-mark\">ZD<span>Y</span></a>\n    <div class=\"header-meta\">远程办公 · 多端协作 · 用量透明</div>\n  </div>\n</header>\n\n<main>\n<section class=\"hero\">\n  <div class=\"container\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-main\">\n        <div class=\"eyebrow\">PRIVATE NETWORK · SINCE 2021</div>\n        <h1>ZDY · 让每一台设备<br>都被<em>认真对待</em>。</h1>\n        <p class=\"hero-lede\">ZDY 是一套为远程协作人群准备的网络工具。清晰的用量、独立的设备通道、按人分配的路由策略——少一点神秘感，多一点可控感。</p>\n        <div class=\"hero-anchor\">\n          <a href=\"#capability\">能力</a>\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#how\">使用方式</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n      <aside class=\"hero-aside\" aria-label=\"当前网络状态\">\n        <h3>当前网络观察窗</h3>\n        <ul class=\"signal-list\">\n          <li><span class=\"k\">主线路</span><span class=\"v\"><span class=\"dot\"></span>运行中</span></li>\n          <li><span class=\"k\">备用线路</span><span class=\"v\"><span class=\"dot\"></span>运行中</span></li>\n          <li><span class=\"k\">本机路由</span><span class=\"v\">智能切换</span></li>\n          <li><span class=\"k\">今日用量</span><span class=\"v\">2.4 GB</span></li>\n          <li><span class=\"k\">在线设备</span><span class=\"v\">2 台</span></li>\n        </ul>\n      </aside>\n    </div>\n  </div>\n</section>\n\n<section id=\"capability\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>三件我们反复打磨的事</h2>\n      <p>围绕远程办公场景，把模糊的体验一项项拆开讲清楚。</p>\n    </div>\n    <div class=\"cards-3\">\n      <article class=\"card\">\n        <div class=\"tag\">01 · 路由</div>\n        <h3>分设备路由</h3>\n        <p>为手机、笔记本、服务器各设一条独立的线路档案。出差、居家、办公室三种网络环境可以并存，不需要反复切换。</p>\n      </article>\n      <article class=\"card\">\n        <div class=\"tag\">02 · 用量</div>\n        <h3>透明计量</h3>\n        <p>面板直接显示本月已用、每日峰值与剩余天数。不存在暗扣流量，也没有隐藏在说明里的阶梯计费。</p>\n      </article>\n      <article class=\"card\">\n        <div class=\"tag\">03 · 协作</div>\n        <h3>团队成员管理</h3>\n        <p>支持为团队成员单独设置流量上限、可用节点与有效期。新成员加入、老成员离开，都有清晰的留痕记录。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>三档订阅，逐行看清</h2>\n      <p>按人填写、按人走单。每档的权益都写在下面，没有附加条款。</p>\n    </div>\n\n    <div class=\"plan-stack\">\n      <article class=\"plan-row\">\n        <div>\n          <div class=\"plan-name\">基础版</div>\n          <div class=\"plan-annual\">适合个人轻度办公</div>\n        </div>\n        <div>\n          <div class=\"plan-price\">¥15<small>/月</small></div>\n          <small class=\"plan-annual\">按年付仅需 ¥150/年</small>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">选择基础版</a>\n      </article>\n\n      <article class=\"plan-row featured\">\n        <div>\n          <div class=\"plan-name\">旗舰版<span class=\"pill\">最受欢迎</span></div>\n          <div class=\"plan-annual\">适合深度远程办公</div>\n        </div>\n        <div>\n          <div class=\"plan-price\">¥35<small>/月</small></div>\n          <small class=\"plan-annual\">按年付仅需 ¥350/年</small>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">选择旗舰版</a>\n      </article>\n\n      <article class=\"plan-row\">\n        <div>\n          <div class=\"plan-name\">团队版</div>\n          <div class=\"plan-annual\">适合 5 人以上的小组</div>\n        </div>\n        <div>\n          <div class=\"plan-price\">¥85<small>/月</small></div>\n          <small class=\"plan-annual\">按年付仅需 ¥850/年</small>\n        </div>\n        <ul class=\"plan-features\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">选择团队版</a>\n      </article>\n    </div>\n\n    <div class=\"usage\" aria-label=\"用量示例\">\n      <h3>用量怎么看的</h3>\n      <p class=\"hint\">下面是一份示意面板。正式使用时会替换为你的实时数据。</p>\n      <div class=\"usage-grid\">\n        <div class=\"usage-item\">\n          <div class=\"label\">本月已用</div>\n          <div class=\"val\">168 GB</div>\n          <div class=\"meta\">较上月 −12%</div>\n          <div class=\"meter\"><span></span></div>\n        </div>\n        <div class=\"usage-item\">\n          <div class=\"label\">本月剩余</div>\n          <div class=\"val\">132 GB</div>\n          <div class=\"meta\">剩余 9 天</div>\n          <div class=\"meter\"><span></span></div>\n        </div>\n        <div class=\"usage-item\">\n          <div class=\"label\">今日峰值</div>\n          <div class=\"val\">22 Mbps</div>\n          <div class=\"meta\">21:40 记录</div>\n          <div class=\"meter\"><span></span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"how\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>四步开始使用</h2>\n      <p>从下单到第一台设备上线，最快五分钟。</p>\n    </div>\n    <div class=\"flow\">\n      <article class=\"step\">\n        <div class=\"num\">01</div>\n        <h4>选择套餐</h4>\n        <p>按月或按年均可，按年单价更低。</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"num\">02</div>\n        <h4>创建密钥</h4>\n        <p>后台自动生成订阅链接与设备密钥。</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"num\">03</div>\n        <h4>导入客户端</h4>\n        <p>把链接复制到任意一台设备即可激活。</p>\n      </article>\n      <article class=\"step\">\n        <div class=\"num\">04</div>\n        <h4>分配路由</h4>\n        <p>为不同设备设置不同的网络策略。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>支持的客户端</h2>\n      <p>主流平台都有一份对应的官方指引，没有的可以向我们提。</p>\n    </div>\n    <div class=\"clients\">\n      <article class=\"client-card\">\n        <div class=\"os\">WINDOWS</div>\n        <h4>Windows 10 / 11</h4>\n        <p>提供 x64 安装包与便携版，适合公司电脑与家用电脑两种场景。</p>\n        <ul>\n          <li>安装包 · 约 78 MB</li>\n          <li>支持开机自启与托盘模式</li>\n          <li>支持系统代理与 TUN 模式</li>\n        </ul>\n        <a href=\"#\" class=\"dl\">下载 Windows 版 →</a>\n      </article>\n      <article class=\"client-card\">\n        <div class=\"os\">MACOS</div>\n        <h4>macOS 12 及以上</h4>\n        <p>通用二进制，兼容 Apple Silicon 与 Intel 机型，支持菜单栏控制。</p>\n        <ul>\n          <li>安装包 · 约 92 MB</li>\n          <li>支持 Apple Silicon 原生运行</li>\n          <li>支持快捷指令与脚本调用</li>\n        </ul>\n        <a href=\"#\" class=\"dl\">下载 macOS 版 →</a>\n      </article>\n      <article class=\"client-card\">\n        <div class=\"os\">MOBILE</div>\n        <h4>iOS · Android</h4>\n        <p>移动端可在应用商店或官网获取，长期使用建议开启按需连接。</p>\n        <ul>\n          <li>iOS 14+ / Android 8+</li>\n          <li>支持 Widget 与快捷开关</li>\n          <li>支持分应用代理</li>\n        </ul>\n        <a href=\"#\" class=\"dl\">查看移动端指引 →</a>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>常见问题</h2>\n      <p>下单前后最常被问到的事，写在下面。</p>\n    </div>\n    <div class=\"faq-list\">\n      <article class=\"faq-item\">\n        <div class=\"num\">01</div>\n        <div>\n          <h3>套餐里的设备数是怎么计算的？</h3>\n          <p>按同时在线的客户端数量计算。一台电脑、一台手机、一个路由器各算一个客户端。同一台设备的多次登录会被识别为同一会话。</p>\n        </div>\n      </article>\n      <article class=\"faq-item\">\n        <div class=\"num\">02</div>\n        <div>\n          <h3>流量用完之后还可以继续连接吗？</h3>\n          <p>用完当月流量后，套餐内设备会进入减速模式，仍可保持连接访问基础服务。下个账期开始后会自动恢复原有速率。</p>\n        </div>\n      </article>\n      <article class=\"faq-item\">\n        <div class=\"num\">03</div>\n        <div>\n          <h3>团队版的成员如何加入？</h3>\n          <p>管理员可在后台生成专属邀请链接，被邀请人通过链接完成注册即可加入。每个成员的流量上限与节点权限都可单独设置。</p>\n        </div>\n      </article>\n      <article class=\"faq-item\">\n        <div class=\"num\">04</div>\n        <div>\n          <h3>可以中途升降级套餐吗？</h3>\n          <p>支持随时升级，差价按剩余天数补齐。降级会在下一个计费周期生效，避免当月数据出现错乱。</p>\n        </div>\n      </article>\n      <article class=\"faq-item\">\n        <div class=\"num\">05</div>\n        <div>\n          <h3>需要自己配置节点吗？</h3>\n          <p>不需要。客户端默认开启智能路由，会按当前网络环境自动挑选可用节点。如果你希望手动指定，也可以在客户端中关闭自动选择。</p>\n        </div>\n      </article>\n      <article class=\"faq-item\">\n        <div class=\"num\">06</div>\n        <div>\n          <h3>海外出差可以使用吗？</h3>\n          <p>可以。建议在出发前在后台勾选「出差模式」，系统会为你的设备分配更合适的线路档案，并在回国后自动还原。</p>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"contact-card\">\n      <div>\n        <div class=\"ch\">SUPPORT</div>\n        <h3>没找到答案</h3>\n        <p>把订单号或设备型号发给我们，工程师会在一个工作日内回复。</p>\n      </div>\n      <div>\n        <div class=\"row\">\n          <div class=\"ch\">工单</div>\n          <div class=\"v\">support@zdy.example</div>\n        </div>\n        <div class=\"row\">\n          <div class=\"ch\">团队咨询</div>\n          <div class=\"v\">team@zdy.example</div>\n        </div>\n        <div class=\"row\">\n          <div class=\"ch\">工作时间</div>\n          <div class=\"v\">周一至周五 · 09:00–21:00</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n</main>\n\n<footer class=\"site-footer\">\n  <div class=\"container\">\n    <div>© ZDY · 一个为远程协作人群准备的网络工具</div>\n    <div class=\"links\">\n      <a href=\"#capability\">能力</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
